    "immer": "^10.0.3",
    "lucide-react": "^1.73.0",
    "mp4box": "^0.5.3",
    "postcss": "^8.5.33",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
