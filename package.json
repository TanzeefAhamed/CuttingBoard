{
  "name": "cuttingboard",
  "version": "0.1.0",
  "description": "Web-based video editor using WebCodecs, WebGL/WebGPU, Web Audio API",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build": "tsc -p tsconfig.json",
    "dev": "vite",
    "lint": "eslint src --ext .ts,.tsx"
  },
  "keywords": [
    "video-editor",
    "webcodecs",
    "webgl",
    "webgpu",
    "webaudio",
    "nle"
  ],
  "author": "",
  "license": "MIT",
